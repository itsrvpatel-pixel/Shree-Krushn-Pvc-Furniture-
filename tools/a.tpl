<script>
(function () {
  var track = document.getElementById('track');
  var dots = [].slice.call(document.querySelectorAll('.dot'));
  if (!track || !dots.length) return;
  var slides = [].slice.call(track.children);
  var paused = false;
  function mark() {
    var mid = track.scrollLeft + track.clientWidth / 2, best = 0, bd = Infinity;
    slides.forEach(function (s, i) {
      var d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
      if (d < bd) { bd = d; best = i; }
    });
    dots.forEach(function (d, i) { d.classList.toggle('on', i === best); });
    return best;
  }
  function go(i) {
    var s = slides[i % slides.length];
    track.scrollTo({ left: s.offsetLeft - (track.clientWidth - s.offsetWidth) / 2, behavior: 'smooth' });
  }
  dots.forEach(function (d) { d.addEventListener('click', function () { paused = true; go(+d.dataset.i); }); });
  track.addEventListener('scroll', function () { requestAnimationFrame(mark); }, { passive: true });
  // Once somebody takes hold of it, it stays where they put it.
  ['pointerdown', 'touchstart', 'wheel'].forEach(function (e) {
    track.addEventListener(e, function () { paused = true; }, { passive: true });
  });
  var t = setInterval(function () { if (!paused) go(mark() + 1); }, 4800);
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) clearInterval(t);
  mark();
})();
</script>
