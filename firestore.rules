rules_version = '2';

// Firestore security rules for Shree Krushn PVC Furniture.
//
// ============================================================
//  DO NOT DEPLOY THESE YET. Read the order below first.
// ============================================================
//
// Today the app reads Firestore with no authentication at all, so the
// rules currently live in the Firebase Console must be allowing
// anonymous reads. That is why the admin PIN, the staff PINs and every
// customer's name, phone number and payment history can be read by
// anyone who opens the site.
//
// Deploying these BEFORE the app is signing in would take the live app
// down for everyone, instantly. The safe order is:
//
//   1. Deploy the app change already in this repo (api/staff-login.js,
//      the custom-token sign-in, and the anonymous sign-in that runs
//      before any data is read).
//   2. Turn ON anonymous sign-in: Firebase console -> Authentication ->
//      Sign-in method -> Anonymous -> Enable. THIS IS NOT OPTIONAL.
//      Staff get an identity from the PIN sign-in, but customers do not:
//      the OTP screen runs in demo mode (the code is generated and checked
//      in the browser) because real phone auth needs the Blaze plan. With
//      anonymous sign-in off, publishing these rules locks every customer
//      out of the app completely.
//   3. In Vercel -> Settings -> Environment Variables set ADMIN_PIN
//      (and PARTNER_PIN / DH_PARTNER_PIN if you use them), then redeploy.
//   4. On real devices, log in as admin, partner, karigar AND a customer
//      and confirm all four still work. Until ADMIN_PIN is set the app
//      silently uses the old in-browser check, so this is the step where
//      you confirm the server path is actually the one running.
//   5. Delete the admin_pin / partner_pin / dh_partner_pin documents in
//      Firestore. Nothing reads them any more.
//   6. Only then paste these rules into the Firebase Console
//      (Firestore Database -> Rules) and publish. Immediately afterwards,
//      open the app as a customer once more and confirm it still loads.
//
// If step 6 goes wrong, republishing the previous rules puts everything
// back immediately - a rules deploy changes no data.
//
// SCOPE: WHAT THIS DOES AND DOES NOT DO
//
// This is phase 1, and it does one thing: the database stops being
// readable by the open internet. You must be signed in - as staff via
// the PIN, or as a customer via OTP - to read anything at all.
//
// It deliberately does NOT narrow access per role, and it CANNOT yet
// narrow per customer. Three reasons:
//
//   * A customer has no identity to key a rule on. In demo mode they sign
//     in anonymously, and an anonymous uid says nothing about which
//     customer they are. Per-customer rules need real Firebase phone auth
//     (request.auth.token.phone_number), which needs the Blaze plan.
//     Until then "this customer may read only their own job" cannot be
//     expressed at all, no matter how the data is shaped.
//
//     Switching that on is a config change, not a code change: enable
//     Blaze, then set VITE_PHONE_AUTH=on in Vercel and redeploy. The app
//     then sends a real SMS and the customer gets a real Firebase session
//     carrying their phone number. That is the point at which the rest of
//     phase 3 becomes possible.
//   * The customers list is still one document, so a reader of it reads
//     every name and phone number.
//   * Role narrowing has real trip-wires in this app. The karigar screen
//     reads the staff list to find its own record, so an admin-only rule
//     on 'staff' would lock karigars out. Rules that look obviously right
//     can break a role silently, and those need testing against your live
//     setup rather than guesswork.
//
// So this draws the line at "signed in or not", which is the line that
// actually matters right now: it stops the open internet reading your
// customers' phone numbers and payment history. Everything finer waits
// for Blaze.

service cloud.firestore {
  match /databases/{database}/documents {

    // All app data lives in one collection keyed by name: 'jobs',
    // 'customers', 'gallery_cat_Kitchen', and so on.
    match /app_data/{docId} {

      function signedIn() {
        return request.auth != null;
      }

      // PIN documents are dead once step 4 above is done. Denying them
      // outright means that if one is ever recreated by accident, it is
      // still never readable from a browser.
      function isSecretDoc() {
        return docId in ['admin_pin', 'partner_pin', 'dh_partner_pin'];
      }

      // Login-attempt counters written by api/staff-login.js. Only the
      // server touches these, and the Admin SDK bypasses rules entirely,
      // so no client needs access: a client that could read them could
      // watch for lockouts, and one that could write them could reset
      // its own failed-attempt count and guess PINs forever.
      function isLoginAttemptDoc() {
        return docId.matches('login_attempts_.*');
      }

      // Note on how these combine: multiple allow statements are OR-ed
      // together, so a second, narrower statement can never take access
      // away that a broader one already granted. Every restriction has
      // to live inside this single condition.
      allow read, write: if signedIn()
                         && !isSecretDoc()
                         && !isLoginAttemptDoc();
    }

    // ------------------------------------------------------------------
    // Jobs and customers: one document each (see src/jobsStore.js).
    //
    // These are the two collections a per-customer rule needs, and the
    // data is now shaped for it: a job carries the customer's phone, and
    // a customer document IS keyed by phone. So the rule you actually
    // want is written out below - it just cannot be switched on yet.
    //
    // WHY NOT YET, AND WHAT TO DO
    //
    // A rule can only recognise a customer by request.auth.token.phone_number,
    // which exists only with real Firebase phone auth. Today the OTP screen
    // runs in demo mode and customers sign in ANONYMOUSLY, so that claim is
    // absent - a phone-matching rule would deny every customer outright.
    //
    // Worse, anonymous sign-in is open to anyone: while it is the customer
    // sign-in method, "signed in" cannot mean "trusted". So per-customer
    // enforcement needs BOTH halves of the same switch:
    //
    //   1. Enable Blaze, set VITE_PHONE_AUTH=on in Vercel, redeploy.
    //   2. Confirm customers now sign in by SMS (the on-screen demo code
    //      is gone) and can still see their own job.
    //   3. Turn OFF anonymous sign-in in the Firebase console, so an
    //      anonymous session can no longer be used to read anything.
    //   4. Replace the two rules below with the commented block beneath
    //      them, and publish.
    //
    // Until step 3, these stay at signed-in-or-not - which still keeps the
    // open internet out, and is the protection that matters most today.
    // ------------------------------------------------------------------

    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    match /customers/{phone} {
      allow read, write: if request.auth != null;
    }

    // The per-customer versions. Swap these in at step 4 above.
    //
    // match /jobs/{jobId} {
    //   function isStaff() {
    //     return request.auth != null && request.auth.token.role != null;
    //   }
    //   function isMine() {
    //     return request.auth != null
    //            && request.auth.token.phone_number == '+91' + resource.data.job.phone;
    //   }
    //   // A customer creating their own job has no resource.data to match
    //   // against yet, so creation is checked against what is being written.
    //   function creatingMine() {
    //     return request.auth != null
    //            && request.auth.token.phone_number == '+91' + request.resource.data.job.phone;
    //   }
    //   allow read:   if isStaff() || isMine();
    //   allow write:  if isStaff() || isMine() || creatingMine();
    // }
    //
    // match /customers/{phone} {
    //   function isStaff() {
    //     return request.auth != null && request.auth.token.role != null;
    //   }
    //   // The document id IS the phone number, so this needs no read of
    //   // the document itself - which also means it works for a customer
    //   // fetching a record that does not exist yet.
    //   function isMe() {
    //     return request.auth != null
    //            && request.auth.token.phone_number == '+91' + phone;
    //   }
    //   allow read, write: if isStaff() || isMe();
    // }
    //
    // Note on what is still shared at that point: notifications are one
    // list for everyone, filtered in the browser, so a customer could read
    // events naming other customers. Narrowing that needs the same phone
    // claim and is the last piece of this work.

    // Reviews the business chooses to show publicly. Published as its own
    // small document (see deriveFeaturedReviews in App.jsx) precisely so a
    // customer can see testimonials without being able to read the jobs
    // they came from - which is what phase 3 has to lock down.
    match /app_data/featured_reviews {
      allow read: if request.auth != null;
    }

    // Anything else is denied. The app writes nothing there.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
