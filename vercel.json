{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/send-visit-reminders",
      "schedule": "30 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/handmade-vase-ikigai1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/handmade-vase-shimai1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?shreekrushnpvcfurniture\\.site"
        }
      ],
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?shreekrushnpvcfurniture\\.site"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
