rules_version = '2';

// PHASE 2 - per-customer rules. This is the file to paste into
// Firebase console -> Cloud Firestore -> Rules.
//
// Before publishing this, anonymous sign-in must be OFF
// (Authentication -> Sign-in method -> Anonymous -> disable).
// Publishing this while anonymous sign-in is still on is not harmful,
// it just leaves the hole open; turning anonymous off while the OLD
// rules are live is also harmless. Either order works. What matters is
// that both are done.
//
// What changes: "signed in" stops meaning "may read everything".
// A customer sees their own record and their own job, and nothing else.

service cloud.firestore {
  match /databases/{database}/documents {

    // Staff carry a role claim in their token, minted by
    // api/staff-login.js after it checks the PIN server-side. A
    // customer's token has no role, so this is false for them.
    function isStaff() {
      return request.auth != null && request.auth.token.role != null;
    }

    // ---- app_data -------------------------------------------------
    // get and list are split deliberately. A rule that names documents
    // cannot authorise a whole-collection query, so leaving them joined
    // as `read` would silently break admin Settings -> "recover missing
    // gallery categories", which lists this collection to find
    // gallery_cat_* documents the pointer forgot. Splitting them keeps
    // that working for staff and still allows nobody else to list.
    match /app_data/{docId} {
      // A customer's own notification document carries their phone in
      // its id, so this needs no read of the document itself.
      function myNotifDoc() {
        return request.auth != null
               && docId == 'customer_notifications_'
                  + request.auth.token.phone_number.replace('\\+91', '');
      }
      // What anyone needs before and after signing in: the gallery, the
      // brochures, the reviews, the price list. These are already
      // public on the website.
      function isPublicAppDoc() {
        return docId in ['categories', 'gallery_categories', 'brochures',
                         'featured_reviews', 'faqs', 'material_specs',
                         'estimate_rates', 'appointment_item_options',
                         'company_benefits']
               || docId.matches('gallery_cat_.*');
      }
      allow get:   if isStaff() || myNotifDoc() || isPublicAppDoc();
      allow list:  if isStaff();
      allow write: if isStaff() || myNotifDoc();
    }

    // ---- jobs -----------------------------------------------------
    // A customer reads exactly one job document, by id (see
    // subscribeOne in src/App.jsx), never the collection - so denying
    // list to everyone but staff costs them nothing.
    match /jobs/{jobId} {
      function isMine() {
        return request.auth != null
               && request.auth.token.phone_number == '+91' + resource.data.job.phone;
      }
      // A customer creating their own job has no resource.data to match
      // against yet, so creation is checked against what is written.
      function creatingMine() {
        return request.auth != null
               && request.auth.token.phone_number == '+91' + request.resource.data.job.phone;
      }
      allow get:   if isStaff() || isMine();
      allow list:  if isStaff();
      allow write: if isStaff() || isMine() || creatingMine();
    }

    // ---- customers ------------------------------------------------
    // The document id IS the phone number, so this needs no read of the
    // document - which also means it works for a customer fetching a
    // record that does not exist yet, right after the OTP at
    // registration.
    match /customers/{phone} {
      function isMe() {
        return request.auth != null
               && request.auth.token.phone_number == '+91' + phone;
      }
      allow get:   if isStaff() || isMe();
      allow list:  if isStaff();
      allow write: if isStaff() || isMe();
    }

    // The role PINs, written by api/change-pin.js and read by
    // api/staff-login.js - both through the Admin SDK, which bypasses
    // rules entirely. Denied to every client, including an admin.
    match /secrets/{docId} {
      allow read, write: if false;
    }

    // Failed-login counters, written only by api/staff-login.js through
    // the Admin SDK. A client that could read these could watch for
    // lockouts; one that could write them could reset its own count and
    // guess a 4-digit PIN at leisure.
    match /login_attempts/{callerId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
